<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified" version="1.0">
  <!--
    XSD 1.0 companion vocabulary for the Algites Orchestrator deployment model.
    Fixed structures, scalar constraints and enums are represented directly.
    Maps whose keys are configuration identifiers are represented by DynamicMapType
    because XSD 1.0 cannot assign one declared complex type to arbitrary element
    names. Full map-entry and cross-entity semantics are enforced by the
    Orchestrator validator.
  -->

  <xs:simpleType name="IdentifierType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z][A-Za-z0-9._-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ConfigurationReferencePathType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z][A-Za-z0-9._-]*(/[A-Za-z][A-Za-z0-9._-]*)*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ConfigVersionType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z0-9][A-Za-z0-9._-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ConfigVersionStateType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z][A-Za-z0-9._-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="ConfigurationReferenceType">
    <xs:all>
      <xs:element name="reference" type="ConfigurationReferencePathType"/>
      <xs:element name="reference_config_version" type="ConfigVersionType"/>
    </xs:all>
  </xs:complexType>

  <xs:simpleType name="NonEmptyStringType">
    <xs:restriction base="xs:string"><xs:minLength value="1"/></xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DataSizeType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[1-9][0-9]*(B|kB|MB|GB|TB|PB|KiB|MiB|GiB|TiB|PiB)"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="TransportProtocolType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="TCP"/>
      <xs:enumeration value="UDP"/>
      <xs:enumeration value="SCTP"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AddressFamilyType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="IPV4"/>
      <xs:enumeration value="IPV6"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="OperatingSystemType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="NIXOS"/>
      <xs:enumeration value="DEBIAN"/>
      <xs:enumeration value="LINUX"/>
      <xs:enumeration value="WINDOWS"/>
      <xs:enumeration value="MACOS"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="StorageClassType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="DISPOSABLE"/>
      <xs:enumeration value="PERSISTENT"/>
      <xs:enumeration value="ARCHIVE"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="RepresentationType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="BLOCK"/>
      <xs:enumeration value="FILESYSTEM"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="BackendType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="QCOW2"/>
      <xs:enumeration value="RAW_FILE"/>
      <xs:enumeration value="LVM"/>
      <xs:enumeration value="DIRECTORY"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="AccessModeType">
    <xs:restriction base="xs:string"><xs:enumeration value="RO"/><xs:enumeration value="RW"/></xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="SharingModeType">
    <xs:restriction base="xs:string"><xs:enumeration value="EXCLUSIVE"/><xs:enumeration value="SHARED"/></xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="InterfaceType">
    <xs:restriction base="xs:string"><xs:enumeration value="SAMBA"/><xs:enumeration value="NFS"/><xs:enumeration value="VIRTIOFS"/></xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="HostNetworkModeType">
    <xs:restriction base="xs:string"><xs:enumeration value="NAT"/><xs:enumeration value="ROUTED"/><xs:enumeration value="BRIDGED"/><xs:enumeration value="ISOLATED"/></xs:restriction>
  </xs:simpleType>

  <xs:complexType name="OperatingSystemConfigurationType">
    <xs:all>
      <xs:element name="type" type="OperatingSystemType"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="EntityIdentityType">
    <xs:all>
      <xs:element name="id" type="IdentifierType"/>
      <xs:element name="display_name" type="NonEmptyStringType"/>
      <xs:element name="description" type="NonEmptyStringType"/>
      <xs:element name="config_version" type="ConfigVersionType"/>
      <xs:element name="config_version_state" type="ConfigVersionStateType"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="NetworkServiceBindingType">
    <xs:all>
      <xs:element name="application_protocol" type="IdentifierType"/>
      <xs:element name="transport_protocol" type="TransportProtocolType"/>
      <xs:element name="port">
        <xs:simpleType><xs:restriction base="xs:positiveInteger"><xs:maxInclusive value="65535"/></xs:restriction></xs:simpleType>
      </xs:element>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="NetworkServiceEndpointType">
    <xs:all>
      <xs:element name="service_binding" type="NetworkServiceBindingType"/>
      <xs:element name="address" type="NonEmptyStringType"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="NetworkServiceInterfaceBindingType">
    <xs:all>
      <xs:element name="service_binding" type="NetworkServiceBindingType"/>
      <xs:element name="network_interface" type="IdentifierType"/>
      <xs:element name="address_family" type="AddressFamilyType" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="DynamicMapType">
    <xs:sequence>
      <xs:any namespace="##local" minOccurs="0" maxOccurs="unbounded" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="StringListType">
    <xs:sequence><xs:element name="item" type="xs:string" minOccurs="0" maxOccurs="unbounded"/></xs:sequence>
  </xs:complexType>

  <xs:complexType name="DescribedItemsType">
    <xs:all>
      <xs:element name="description" type="NonEmptyStringType"/>
      <xs:element name="items" type="DynamicMapType"/>
    </xs:all>
  </xs:complexType>
</xs:schema>
