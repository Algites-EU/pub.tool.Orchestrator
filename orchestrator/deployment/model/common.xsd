<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:annotation>
    <xs:documentation>
      Shared XML Schema types for Algites Orchestrator deployment model version 1.
      The XML representation is the deterministic object-to-element mapping used by
      the Orchestrator XML serializer. Dynamic identifier-keyed maps are represented
      by dynamically named XML child elements; XSD 1.0 cannot apply one complex type
      to arbitrary child element names, therefore map containers use xs:any while the
      Orchestrator performs the full identifier and cross-configuration validation.
    </xs:documentation>
  </xs:annotation>

  <xs:simpleType name="IdentifierType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z][A-Za-z0-9._-]*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="ConfigurationReferenceType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[A-Za-z][A-Za-z0-9._-]*(/[A-Za-z][A-Za-z0-9._-]*)*"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="NonEmptyStringType">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="DataSizeType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[1-9][0-9]*(B|kB|MB|GB|TB|PB|KiB|MiB|GiB|TiB|PiB)"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MountableResourceStorageClassType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="DISPOSABLE"/>
      <xs:enumeration value="PERSISTENT"/>
      <xs:enumeration value="ARCHIVE"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MountableResourcePurposeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="SYSTEM"/>
      <xs:enumeration value="DATA"/>
      <xs:enumeration value="CACHE"/>
      <xs:enumeration value="BACKUP"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MountableResourceRepresentationType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="BLOCK"/>
      <xs:enumeration value="FILESYSTEM"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MountableResourceAccessModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="RO"/>
      <xs:enumeration value="RW"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MountableResourceSharingModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="EXCLUSIVE"/>
      <xs:enumeration value="SHARED"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MountableResourceInterfaceType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="SAMBA"/>
      <xs:enumeration value="NFS"/>
      <xs:enumeration value="VIRTIOFS"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MountableResourceBackendType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="QCOW2"/>
      <xs:enumeration value="RAW_FILE"/>
      <xs:enumeration value="LVM"/>
      <xs:enumeration value="DIRECTORY"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MountableResourceRelationRequirementType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="REQUIRED"/>
      <xs:enumeration value="PREFERRED"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="MountableResourceRelationType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="NO_SHARED_DEVICE"/>
      <xs:enumeration value="NO_SHARED_CONTROLLER"/>
      <xs:enumeration value="NO_SHARED_STORAGE_SYSTEM"/>
      <xs:enumeration value="NO_SHARED_HOST"/>
      <xs:enumeration value="NO_SHARED_SITE"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="HostStorageDeviceType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="PHYSICAL_DISK"/>
      <xs:enumeration value="PARTITION"/>
      <xs:enumeration value="RAID"/>
      <xs:enumeration value="LVM_PV"/>
      <xs:enumeration value="LVM_VG"/>
      <xs:enumeration value="LVM_LV"/>
      <xs:enumeration value="OTHER"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="HostNetworkModeType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="ISOLATED"/>
      <xs:enumeration value="NAT"/>
      <xs:enumeration value="ROUTED"/>
      <xs:enumeration value="BRIDGED"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="GuestOsType">
    <xs:restriction base="xs:string">
      <xs:enumeration value="NIXOS"/>
      <xs:enumeration value="LINUX"/>
      <xs:enumeration value="WINDOWS"/>
      <xs:enumeration value="MACOS"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="EntityIdentityType">
    <xs:all>
      <xs:element name="id" type="IdentifierType"/>
      <xs:element name="display_name" type="NonEmptyStringType"/>
      <xs:element name="description" type="NonEmptyStringType"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="DataSizeConstraintType">
    <xs:all>
      <xs:element name="minimum" type="DataSizeType" minOccurs="0"/>
      <xs:element name="default" type="DataSizeType" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="IdentifierListType">
    <xs:sequence>
      <xs:element name="item" type="IdentifierType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="IdentifierListTwoOrMoreType">
    <xs:sequence>
      <xs:element name="item" type="IdentifierType" minOccurs="2" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="RelationTypeListType">
    <xs:sequence>
      <xs:element name="item" type="MountableResourceRelationType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DynamicMapType">
    <xs:sequence>
      <xs:any minOccurs="0" maxOccurs="unbounded" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="DynamicMapOneOrMoreType">
    <xs:sequence>
      <xs:any minOccurs="1" maxOccurs="unbounded" processContents="skip"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="MountableResourceType">
    <xs:all>
      <xs:element name="display_name" type="NonEmptyStringType"/>
      <xs:element name="description" type="NonEmptyStringType"/>
      <xs:element name="storage_class" type="MountableResourceStorageClassType"/>
      <xs:element name="purpose" type="MountableResourcePurposeType"/>
      <xs:element name="representation" type="MountableResourceRepresentationType"/>
      <xs:element name="access" type="MountableResourceAccessModeType"/>
      <xs:element name="sharing" type="MountableResourceSharingModeType"/>
      <xs:element name="mount_point" type="NonEmptyStringType"/>
      <xs:element name="capacity" type="DataSizeConstraintType" minOccurs="0"/>
      <xs:element name="required_interface" type="MountableResourceInterfaceType" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="MountableResourceRelationConfigurationType">
    <xs:all>
      <xs:element name="display_name" type="NonEmptyStringType"/>
      <xs:element name="description" type="NonEmptyStringType"/>
      <xs:element name="mountable_resources" type="IdentifierListTwoOrMoreType"/>
      <xs:element name="relations" type="RelationTypeListType"/>
      <xs:element name="requirement" type="MountableResourceRelationRequirementType"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="BackendConfigurationType">
    <xs:all>
      <xs:element name="type" type="MountableResourceBackendType"/>
      <xs:element name="description" type="NonEmptyStringType"/>
      <xs:element name="directory" type="NonEmptyStringType" minOccurs="0"/>
      <xs:element name="volume_group" type="NonEmptyStringType" minOccurs="0"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="BackendConfigurationListType">
    <xs:sequence>
      <xs:element name="item" type="BackendConfigurationType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="HostStorageTargetRepresentationType">
    <xs:all>
      <xs:element name="type" type="MountableResourceRepresentationType"/>
      <xs:element name="description" type="NonEmptyStringType"/>
      <xs:element name="supported_backends" type="BackendConfigurationListType"/>
    </xs:all>
  </xs:complexType>

  <xs:complexType name="HostStorageTargetRepresentationListType">
    <xs:sequence>
      <xs:element name="item" type="HostStorageTargetRepresentationType" minOccurs="1" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="HostStorageTargetType">
    <xs:all>
      <xs:element name="display_name" type="NonEmptyStringType"/>
      <xs:element name="description" type="NonEmptyStringType"/>
      <xs:element name="storage_class" type="MountableResourceStorageClassType"/>
      <xs:element name="storage_system" type="IdentifierType"/>
      <xs:element name="impacted_devices" type="IdentifierListType" minOccurs="0"/>
      <xs:element name="impacted_controllers" type="IdentifierListType" minOccurs="0"/>
      <xs:element name="supported_representations" type="HostStorageTargetRepresentationListType"/>
    </xs:all>
  </xs:complexType>
</xs:schema>
